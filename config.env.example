# Copy only to the external per-user config directory described in README.md.
EMAIL_USER=your@email.com
EMAIL_PASSWORD=your_app_password
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
# false requires verified STARTTLS before login (usually port 143).
EMAIL_IMAP_SSL=true
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=465
# false requires verified STARTTLS before login (usually port 587).
EMAIL_SMTP_SSL=true
EMAIL_SIGNATURE_FILE=signature.txt
