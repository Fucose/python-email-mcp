{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "python-email": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--project", "${PLUGIN_ROOT}", "--locked", "python-email-mcp", "mcp"],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${PLUGIN_DATA}/venv"
      }
    }
  }
}
